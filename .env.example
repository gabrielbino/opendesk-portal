# ============================================================================
# Portal OpenDesk (helpdesk-system) — exemplo de variáveis de ambiente
# ----------------------------------------------------------------------------
# Copie para `.env` e preencha. NÃO versionar o `.env`.
# Gotcha (dotenv@17): valores que contêm `#` precisam estar entre "aspas duplas".
# Ver docs/migracao-infra-propria.md (§8) para o papel de cada variável.
# ============================================================================

# ---- Núcleo -----------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Conexão MySQL 8 da VM (a conexão força timezone=Z internamente):
DATABASE_URL="mysql://opendesk:SUA_SENHA@127.0.0.1:3306/opendesk"
# Assina/valida o cookie de sessão. Use o MESMO valor do Manus para não deslogar
# todos os usuários no cutover; se não conseguir, gere um novo (todos relogam).
JWT_SECRET="troque-por-um-segredo-forte"

# ---- API Erp (queries nomeadas — não muda na migração) -------------------
ERP_API_URL="https://..."
ERP_API_USER=""
ERP_API_SENHA=""

# ---- Tokens dos agentes/conectores (mesmos valores do Manus) ----------------
CONNECTOR_SHARED_TOKEN=""
PARCIAL_BOT_TOKEN=""
MONITOR_AGENTE_TOKEN=""

# ---- Jobs agendados fora do Manus (NOVO — ver §3.1) -------------------------
# Header dos crontab/systemd timers: Authorization: Bearer <este valor>.
CRON_SHARED_TOKEN="troque-por-um-segredo-forte"

# ---- Storage de arquivos (NOVO — ver §3.2) ----------------------------------
# STORAGE_DRIVER = s3 | local | forge
#   (sem valor: usa "forge" se houver credencial Forge, senão "local")
STORAGE_DRIVER=local

# Base pública do portal — usada para URLs absolutas do driver "local".
PUBLIC_BASE_URL="https://portal.SEU-DOMINIO.com.br"

# -- Driver local (disco da VM) --
LOCAL_STORAGE_DIR=/var/lib/opendesk/uploads

# -- Driver s3 (AWS) ou compatível (MinIO) --
S3_BUCKET=""
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Para MinIO/S3-compatível: informe o endpoint e o path-style.
S3_ENDPOINT=""            # ex.: https://minio.interno:9000 (vazio = AWS)
S3_FORCE_PATH_STYLE=false # MinIO = true
S3_PUBLIC_URL=""          # opcional; se vazio, usa URL pré-assinada

# ---- Backup embutido (02:00 — opcional) -------------------------------------
GITHUB_BACKUP_TOKEN=""
GITHUB_BACKUP_REPO_URL=""

# ---- Manus (LEGADO — só enquanto rodar no Manus / durante a migração) -------
# BUILT_IN_FORGE_* são INJETADOS pela plataforma Manus (não aparecem na lista de
# "Segredos do aplicativo"). Necessários apenas para STORAGE_DRIVER=forge e para
# migrar os anexos existentes do Forge. Fora do Manus, deixe em branco.
BUILT_IN_FORGE_API_URL=""
BUILT_IN_FORGE_API_KEY=""
# OAuth/SSO do Manus — o login interno (e-mail/senha) não depende disto.
OAUTH_SERVER_URL=""
OWNER_OPEN_ID=""

# ---- Frontend / sessão (prefixo VITE_) --------------------------------------
# VITE_APP_ID: precisa de um valor NÃO-VAZIO fora do Manus. O token de sessão do
# login interno carrega este `appId` e o verifySession exige que ele não seja vazio
# — sem isso o login "entra" mas a sessão é rejeitada ("Session payload missing
# required fields") e volta pra tela de login. Use qualquer id próprio (ex.: opendesk-portal).
# (No build, o "modo Manus" só liga se VITE_APP_ID estiver EXPORTADO no shell do build;
#  defini-la só no .env NÃO ativa o modo Manus — o servidor a lê em runtime.)
VITE_APP_ID=opendesk-portal
# NÃO definir VITE_OAUTH_PORTAL_URL fora do Manus (mantém o login interno; se definir,
# o botão de login tenta o OAuth do Manus). VITE_DEV_BYPASS_AUTH só para dev local.
# VITE_OAUTH_PORTAL_URL=
# VITE_DEV_BYPASS_AUTH=false
