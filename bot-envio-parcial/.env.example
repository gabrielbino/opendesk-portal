# ── Portal (VM própria) ─────────────────────────────────────────────────────
# URL base do portal. O bot fala com /api/parcial/* aqui.
# Rede interna (mesma LAN da VM do portal): http://10.0.0.10
HELPDESK_URL=http://10.0.0.10
# Mesmo valor configurado como PARCIAL_BOT_TOKEN no .env do portal.
PARCIAL_BOT_TOKEN=troque-por-um-token-forte
# Intervalo do heartbeat em ms (padrão 3000).
HEARTBEAT_MS=3000

# ── SQL Server (DMD / ERP) — rede interna ───────────────────────────────
# ATENÇÃO (dotenv): se a senha contiver '#', coloque o valor entre aspas duplas.
DB_SERVER=SRV-ERP-DB\SQL2012
DB_DATABASE=DMD
DB_USER=ti
DB_PASSWORD="sua_senha_aqui"
DB_PORT=1433

# ── Opcionais ───────────────────────────────────────────────────────────────
# Caminho do Chrome/Chromium (necessário no Linux headless; no Windows pode omitir).
# CHROME_PATH=/usr/bin/chromium-browser
# Binário do Python (padrão: 'python' no Windows, 'python3' no Linux).
# PYTHON_BIN=python
