# ── Backup mensal de pedidos (VM srvappapi) ──────────────────────────────────
# Copie para .env e preencha. Valores com # precisam de aspas (cuidado com dotenv).

# Base do portal (Manus) — as rotas /api/monitor-arquivos/* penduram aqui.
PORTAL_URL=https://<dominio-do-portal>

# Mesmo token dos demais agentes do Monitor (coletor/gateway) e do Manus.
MONITOR_AGENTE_TOKEN=<mesmo valor do Manus>

# Mapeamento de mount: o config guarda o caminho como o COLETOR o vê (mount RO).
# Este job ESCREVE, então usa um mount RW dedicado. Ex.: /mnt/erp (ro) → /mnt/erp-rw (rw).
# Se ambos vazios, o job usa o caminho do config como está.
MOUNT_RO=/mnt/erp
MOUNT_RW=/mnt/erp-rw

# Timeout por requisição ao portal (s). O zip pode demorar; o report é rápido.
HTTP_TIMEOUT_SEG=60
