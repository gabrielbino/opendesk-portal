# ── Portal (VM própria) ─────────────────────────────────────────────────────
# URL base do portal. O coletor fala com /api/monitor-arquivos/* aqui.
# Rede interna (mesma LAN da VM do portal): http://localhost
PORTAL_URL=http://localhost

# Mesmo valor configurado como MONITOR_AGENTE_TOKEN no .env do portal.
# ATENÇÃO (dotenv@17): se o token contiver '#', coloque o valor entre aspas duplas.
MONITOR_AGENTE_TOKEN=troque-por-um-token-forte

# ── Ritmo do coletor ────────────────────────────────────────────────────────
# Intervalo do heartbeat em segundos (marca "online" + recebe os caminhos). Padrão 30.
HEARTBEAT_SEG=30
# Intervalo do tick em segundos: com que frequência checa se alguma pasta "venceu"
# (o intervalo real de cada pasta vem do painel: intervaloVarreduraSeg). Padrão 5.
TICK_SEG=5
# Timeout de cada requisição ao portal (s). Se o portal ficar lento/indisponível, a chamada
# aborta rápido em vez de pendurar o laço (um caminho lento não segura os outros). Padrão 20.
HTTP_TIMEOUT_SEG=20
