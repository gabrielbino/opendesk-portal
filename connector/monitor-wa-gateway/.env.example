# ── WA Gateway (VM srvappapi) ────────────────────────────────────────────────
# Copie para .env e preencha. Valores com # precisam de aspas (cuidado com dotenv).

# Base do portal (portal) — as rotas /api/monitor-arquivos/* penduram aqui.
PORTAL_URL=https://<dominio-do-portal>

# Mesmo token dos demais agentes do Monitor (coletor/backup) e do portal.
MONITOR_AGENTE_TOKEN=<mesmo valor do portal>

# Ritmo (segundos).
HEARTBEAT_SEG=30      # reporta status + recebe as contas a rodar
POLL_SEG=8            # de quanto em quanto puxa a fila de cada conta
HTTP_TIMEOUT_SEG=20
PULL_LIMIT=10         # máx. de mensagens por pull
ENVIO_DELAY_MS=1500   # pausa entre envios (anti-spam)

# Pasta das sessões (LocalAuth). Uma subpasta por conta. Não versionar.
SESSAO_DIR=./.wwebjs_auth

# Interpretador Python p/ renderizar a imagem do RESUMO DIÁRIO (Pillow). Default: python3.
# Só defina se o binário tiver outro nome/caminho na VM.
# PYTHON_BIN=python3
