[Unit]
# ─────────────────────────────────────────────────────────────────────────────
# WA Gateway "Monitor de Integrações" (OpenDesk) — serviço systemd (Linux).
# Roda na VM srvappapi. Restart=always faz voltar sozinho após queda.
# Placeholders __USER__ / __DIR__ / __NODE__ preenchidos pelo install-service.sh.
# ─────────────────────────────────────────────────────────────────────────────
Description=WA Gateway - Monitor de Integrações (OpenDesk)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__NODE__ index.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=NODE_ENV=production
Environment=TZ=America/Sao_Paulo

[Install]
WantedBy=multi-user.target
