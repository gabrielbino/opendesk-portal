# OpenDesk — Query API (copie para .env)
PORT=4000

# Credenciais que o PORTAL usa (ERP_API_USER/SENHA no portal apontam para cá).
QAPI_USER=portal
QAPI_PASSWORD=portal-dev

# Admin da UI (autoria/teste de queries).
QAPI_ADMIN_USER=admin
QAPI_ADMIN_PASSWORD=admin

# Segredo do JWT emitido no login.
JWT_SECRET=troque-por-um-segredo-forte

# Banco-alvo onde as queries rodam (e onde vive o registro qapi_queries).
# Em docker-compose aponte para o serviço demo-erp-db.
TARGET_DB_URL=mysql://root:dev@127.0.0.1:3306/demo_erp

# Validade do token (minutos).
TOKEN_TTL_MIN=30
